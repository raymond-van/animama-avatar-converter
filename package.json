{
  "name": "animama-avatar-converter",
  "version": "0.1.1",
  "description": "Convert a VRChat Avatar you own to a VRM file for Animama, from the command line. Runs locally; uploads nothing.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raymond-van/animama-avatar-converter.git"
  },
  "keywords": [
    "vrchat",
    "vrm",
    "unity",
    "animama"
  ],
  "type": "module",
  "bin": {
    "animama-avatar-converter": "cli/main.mjs"
  },
  "files": [
    "cli/*.mjs",
    "!cli/*.test.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"cli/*.test.mjs\" \"scripts/*.test.mjs\"",
    "check": "node scripts/check.mjs",
    "prepublishOnly": "node scripts/prepublish.mjs && npm test"
  }
}
